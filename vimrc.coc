if !executable('node')
  finish
endif

set hidden
set nobackup
set nowritebackup
set cmdheight=2
set updatetime=300
set shortmess+=c
set signcolumn=yes

let g:coc_global_extensions = [
  \ 'coc-pyright',
  \ 'coc-go',
  \ 'coc-tsserver',
  \ 'coc-kotlin',
  \ 'coc-json',
  \ 'coc-yaml',
  \ 'coc-github-copilot',
  \ 'coc-pairs'
  \ ]

" Prevent vim-go from registering its own gd so CoC owns it
let g:go_def_mapping_enabled = 0

" TAB/S-TAB: navigate completion popup (Enter is reserved for UltiSnips)
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ coc#inline#visible() ? coc#inline#accept() :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

function! s:check_back_space() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" C-y confirms completion; Enter is left free for UltiSnips
inoremap <silent><expr> <C-y> coc#pum#visible() ? coc#pum#confirm() : "\<C-y>"
inoremap <silent><expr> <C-space> coc#refresh()

" Diagnostics navigation
nmap <silent> [g <Plug>(coc-diagnostic-prev)
nmap <silent> ]g <Plug>(coc-diagnostic-next)

" Goto mappings
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr :<C-u>Telescope coc references<CR>

" Give CoC's floating windows (hover, signature help, etc.) a background and
" border that stand out from the editor background, since the default
" CocFloating highlight can end up nearly indistinguishable from Normal.
function! s:setup_coc_float_highlights() abort
  hi CocFloating    guibg=#44475a guifg=#f8f8f2
  hi CocFloatBorder guifg=#bd93f9 guibg=#44475a
  hi CocFloatActive guifg=#50fa7b guibg=#44475a
  " Completion popup menu: unselected items sit on CocFloating's bg;
  " give the selected (tabbed-to) item a strongly contrasting highlight.
  hi CocPumMenu   guibg=#44475a guifg=#f8f8f2
  hi CocMenuSel   guibg=#bd93f9 guifg=#282a36 gui=bold cterm=bold
endfunction

" coc.nvim itself resets these on VimEnter/ColorScheme (see s:Highlight() in
" plugin/coc.vim, registered at plug#end() time, i.e. before this file is
" sourced). Re-apply ours afterwards on the same events so they stick.
call s:setup_coc_float_highlights()
autocmd VimEnter,ColorScheme * call s:setup_coc_float_highlights()

call coc#config('hover', {
  \ 'floatConfig': {
  \   'border': v:true,
  \   'highlight': 'CocFloating',
  \   'borderhighlight': 'CocFloatBorder',
  \   'winblend': 0
  \ }
  \ })

" Hover documentation
nnoremap <silent> K :call <SID>show_documentation()<CR>
nnoremap <silent> <leader>K :call CocActionAsync('doHover')<CR>
nnoremap <silent> gh  =CocActionAsync('showSignatureHelp')<CR>

function! s:show_documentation()
  if index(['vim', 'help'], &filetype) >= 0
    execute 'h ' . expand('<cword>')
  elseif coc#rpc#ready()
    call CocActionAsync('doHover')
  else
    execute '!' . &keywordprg . ' ' . expand('<cword>')
  endif
endfunction

" Type-under-cursor for the statusline: fetch hover info without popping
" any UI, keep the first meaningful line, and surface it via airline.
let g:coc_hover_type = ''

function! s:set_coc_hover_type(err, hovers) abort
  let l:type = ''
  if empty(a:err) && type(a:hovers) == v:t_list && len(a:hovers) > 0
    for l:line in split(a:hovers[0], "\n")
      let l:line = trim(l:line)
      if l:line !=# '' && l:line !~# '^```'
        let l:type = l:line
        break
      endif
    endfor
  endif
  if strchars(l:type) > 80
    let l:type = strcharpart(l:type, 0, 80) . '...'
  endif
  let g:coc_hover_type = l:type
  if exists('*airline#update_statusline')
    call airline#update_statusline()
  endif
endfunction

function! s:update_coc_hover_type() abort
  if !coc#rpc#ready()
    return
  endif
  call CocActionAsync('getHover', '', function('s:set_coc_hover_type'))
endfunction

function! CocHoverTypeStatus() abort
  return get(g:, 'coc_hover_type', '')
endfunction

if exists('*airline#parts#define_raw')
  call airline#parts#define_raw('coc_type', '%{CocHoverTypeStatus()}')
  let g:airline_section_x = airline#section#create_right(['coc_type', 'filetype'])
endif

autocmd CursorHold * silent call CocActionAsync('highlight')

" Rename / format
nmap <leader>rn <Plug>(coc-rename)
xmap <leader>f  <Plug>(coc-format-selected)
nmap <leader>f  <Plug>(coc-format-selected)

" Code actions
nmap <leader>. <Plug>(coc-codeaction-cursor)
imap <leader>. <Plug>(coc-codeaction-cursor)
xmap <leader>a  <Plug>(coc-codeaction-selected)
nmap <leader>a  <Plug>(coc-codeaction-selected)
nmap <leader>ac <Plug>(coc-codeaction)
nmap <leader>qf <Plug>(coc-fix-current)

" Text objects for functions
xmap if <Plug>(coc-funcobj-i)
xmap af <Plug>(coc-funcobj-a)
omap if <Plug>(coc-funcobj-i)
omap af <Plug>(coc-funcobj-a)

command! -nargs=0 Format  :call CocActionAsync('format')
command! -nargs=? Fold    :call CocAction('fold', <f-args>)
command! -nargs=0 OR      :call CocActionAsync('runCommand', 'editor.action.organizeImport')

" CocList bindings — <leader>l prefix; <Space> alone is taken by Telescope live_grep
nnoremap <silent> <leader>la :<C-u>CocList diagnostics<CR>
nnoremap <silent> <leader>le :<C-u>CocList extensions<CR>
nnoremap <silent> <leader>lc :<C-u>CocList commands<CR>
nnoremap <silent> <leader>lo :<C-u>CocList outline<CR>
nnoremap <silent> <leader>ls :<C-u>CocList -I symbols<CR>
nnoremap <silent> <leader>lj :<C-u>CocNext<CR>
nnoremap <silent> <leader>lk :<C-u>CocPrev<CR>
nnoremap <silent> <leader>lp :<C-u>CocListResume<CR>

set statusline^=%{coc#status()}%{get(b:,'coc_current_function','')}


lua << EOF
local actions = require("telescope.actions")
local action_state = require("telescope.actions.state")

local function get_path(entry)
  return entry.path or entry.filename or entry.value
end

local function open_vsplit(prompt_bufnr)
  local selected = action_state.get_selected_entry()
  local filepath = get_path(selected)
  actions.close(prompt_bufnr)
  if filepath then
    vim.cmd("vsplit " .. vim.fn.fnameescape(filepath))
  end
end

local function open_split(prompt_bufnr)
  local selected = action_state.get_selected_entry()
  local filepath = get_path(selected)
  actions.close(prompt_bufnr)
  if filepath then
    vim.cmd("split " .. vim.fn.fnameescape(filepath))
  end
end

require("telescope").setup({
  defaults = {
    vimgrep_arguments = {
      "rg", "--color=never", "--no-heading", "--with-filename",
      "--line-number", "--column", "--smart-case", "--hidden",
      "--glob", "!**/.git/*",
    },
    file_ignore_patterns = { "^.git/" },
    layout_strategy = "flex",
    layout_config = { prompt_position = "top" },
    sorting_strategy = "ascending",
    path_display = { "filename_first" },
    
    mappings = {
      i = {
        ["<C-j>"] = actions.move_selection_next,
        ["<C-k>"] = actions.move_selection_previous,
        ["<C-b>"] = open_vsplit,
        ["<C-x>"] = open_split,
        ["<C-t>"] = actions.select_tab,
        ["<Esc>"] = actions.close,
      },
      n = {
        ["<C-j>"] = actions.move_selection_next,
        ["<C-k>"] = actions.move_selection_previous,
        ["<C-b>"] = open_vsplit,
        ["<C-x>"] = open_split,
        ["<C-t>"] = actions.select_tab,
        ["q"]     = actions.close,
      },
    },
  },
  pickers = {
    find_files = { hidden = true },
    live_grep  = { additional_args = function() return { "--hidden" } end },
  },
  extensions = {
    fzf = {
      fuzzy = true,
      override_generic_sorter = true,
      override_file_sorter = true,
      case_mode = "smart_case",
    },
    coc = {
      prefer_locations = true,
      push_cursor_on_edit = true,
      timeout = 3000,
    },
  },
})
require("telescope").load_extension("coc")

EOF

augroup coc_config
  autocmd!
  autocmd FileType typescript,json setl formatexpr=CocAction('formatSelected')
  autocmd User CocJumpPlaceholder call CocActionAsync('showSignatureHelp')
  autocmd CursorHold,CursorHoldI * call s:update_coc_hover_type()
augroup END
